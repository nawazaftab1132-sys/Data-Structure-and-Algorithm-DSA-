#include<iostream>
using namespace std;
int main()
{
    int k;
    cout << "Enter size: ";
    cin >> k;
    int arr[k];
    cout << "Enter values: ";
    for(int i = 0; i < k; i++)
    {
        cin >> arr[i];
    }
    for(int i = 0; i < k - 1; i++)
    {
        int min = i;

        for(int j = i + 1; j < k; j++)
        {
            if(arr[j] < arr[min])
            {
                min = j;
            }
        }
        int temp = arr[i];
        arr[i] = arr[min];
        arr[min] = temp;
    }
    cout << "Sorted array: ";
    for(int i = 0; i < k; i++)
    {
        cout << arr[i] << " ";
    }
}
