#include<iostream>
using namespace std;
int main()
{
    int arr[10];
      cout << "Enter 10 numbers in sorted order:" << endl;
    for(int i = 0; i < 10; i++)
    {
        cin >> arr[i];
    }
    int a, m;
    cout << "Enter search number: ";
    cin >> a;
    int f = 0;
    int l = 9;
    while(f <= l)
    {
        m = (f + l) / 2;
        if(arr[m] == a)
        {
            cout << "Your number is at index = " << m << endl;
            break;
        }
        else if(a > arr[m])
        {
            f = m + 1;       
        }
        else if(a < arr[m])
        {
            l = m - 1;       
        }
             m = (f + l) / 2;   
    }
    if(f > l)
    {
        cout << "Element not found" << endl;
    }
}
