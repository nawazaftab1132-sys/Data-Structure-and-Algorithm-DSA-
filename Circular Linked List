#include <iostream>
using namespace std;

struct node
{
    int data;
    node *next;
};

node *head = NULL;
node *tail = NULL;

void first(int val)
{
    node *n = new node;
    n->data = val;

    if(head == NULL)
    {
        head = tail = n;
        n->next = head;
    }
    else
    {
        n->next = head;
        head = n;
        tail->next = head;
    }
}

void last(int val)
{
    node *n = new node;
    n->data = val;

    if(head == NULL)
    {
        head = tail = n;
        n->next = head;
    }
    else
    {
        tail->next = n;
        tail = n;
        tail->next = head;
    }
}

void update(int oldval, int newval)
{
    if(head == NULL)
        return;

    node *temp = head;

    do
    {
        if(temp->data == oldval)
        {
            temp->data = newval;
            return;
        }
        temp = temp->next;
    }
    while(temp != head);

    cout << "Value not found\n";
}

void del(int val)
{
    if(head == NULL)
        return;

    node *temp = head;
    node *prev = tail;

    do
    {
        if(temp->data == val)
            break;

        prev = temp;
        temp = temp->next;
    }
    while(temp != head);

    if(temp->data != val)
    {
        cout << "Value not found\n";
        return;
    }

    if(head == tail)
    {
        head = tail = NULL;
    }
    else
    {
        prev->next = temp->next;

        if(temp == head)
            head = temp->next;

        if(temp == tail)
            tail = prev;
    }

    if(head != NULL)
        tail->next = head;

    delete temp;
}

void display()
{
    if(head == NULL)
        return;

    node *temp = head;

    do
    {
        cout << temp->data << " ";
        temp = temp->next;
    }
    while(temp != head);

    cout << endl;
}

void reverseHelper(node *temp)
{
    if(temp == head)
        return;

    reverseHelper(temp->next);
    cout << temp->data << " ";
}

void reverseDisplay()
{
    if(head == NULL)
        return;

    reverseHelper(head->next);
    cout << head->data << " ";
}

int main()
{
    first(20);
    first(10);
    last(30);
    last(40);

    cout << "Display: ";
    display();

    update(20, 25);

    cout << "After Update: ";
    display();

    del(30);

    cout << "After Delete: ";
    display();

    cout << "Reverse Display: ";
    reverseDisplay();

    return 0;
}
