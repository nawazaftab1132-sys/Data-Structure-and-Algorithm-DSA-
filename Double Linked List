#include <iostream>
using namespace std;

struct node
{
    int data;
    node *next;
    node *prev;
};

node *head = NULL;
node *tail = NULL;

void first(int val)
{
    node *n = new node;
    n->data = val;
    n->prev = NULL;
    n->next = head;

    if(head == NULL)
        tail = n;
    else
        head->prev = n;

    head = n;
}

void last(int val)
{
    node *n = new node;
    n->data = val;
    n->next = NULL;
    n->prev = tail;

    if(head == NULL)
        head = tail = n;
    else
    {
        tail->next = n;
        tail = n;
    }
}

void update(int oldval, int newval)
{
    node *temp = head;

    while(temp != NULL)
    {
        if(temp->data == oldval)
        {
            temp->data = newval;
            return;
        }
        temp = temp->next;
    }

    cout << "Value not found\n";
}

void del(int val)
{
    node *temp = head;

    while(temp != NULL && temp->data != val)
        temp = temp->next;

    if(temp == NULL)
    {
        cout << "Value not found\n";
        return;
    }

    if(temp->prev != NULL)
        temp->prev->next = temp->next;
    else
        head = temp->next;

    if(temp->next != NULL)
        temp->next->prev = temp->prev;
    else
        tail = temp->prev;

    delete temp;
}

void display()
{
    node *temp = head;

    while(temp != NULL)
    {
        cout << temp->data << " ";
        temp = temp->next;
    }
    cout << endl;
}

void reverseDisplay()
{
    node *temp = tail;

    while(temp != NULL)
    {
        cout << temp->data << " ";
        temp = temp->prev;
    }
}

int main()
{
    first(20);
    first(10);
    last(30);
    last(40);

    cout << "Display: ";
    display();

    update(20, 25);

    cout << "After Update: ";
    display();

    del(30);

    cout << "After Delete: ";
    display();

    cout << "Reverse Display: ";
    reverseDisplay();

    return 0;
}
