#include <iostream>
using namespace std;
int main()
{
    int arr[100];
    int n;
    cout << "Enter number of elements: ";
    cin >> n;
    cout << "Enter array elements:\n";
    for(int i = 0; i < n; i++)
    {
        cin >> arr[i];
    }
    int position;
    cout << "Enter position to delete (0 to " << n - 1 << "): ";
    cin >> position;
    for(int i = position; i < n - 1; i++)
    {
        arr[i] = arr[i + 1];
    }
    n--;
    cout << "Array after deletion:\n";
    for(int i = 0; i < n; i++)
    {
        cout << arr[i] << " ";
    }
}
