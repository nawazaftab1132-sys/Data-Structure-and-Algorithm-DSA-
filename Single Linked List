#include <iostream>
using namespace std;

struct node
{
    int data;
    node *next;
};

node *head = NULL;
node *tail = NULL;

void first(int val)
{
    node *n = new node;
    n->data = val;
    n->next = head;

    if(head == NULL)
        tail = n;

    head = n;
}

void last(int val)
{
    node *n = new node;
    n->data = val;
    n->next = NULL;

    if(head == NULL)
        head = tail = n;
    else
    {
        tail->next = n;
        tail = n;
    }
}

void update(int oldval, int newval)
{
    node *temp = head;

    while(temp != NULL)
    {
        if(temp->data == oldval)
        {
            temp->data = newval;
            return;
        }
        temp = temp->next;
    }

    cout << "Value not found\n";
}

void del(int val)
{
    node *temp = head;
    node *prev = NULL;

    while(temp != NULL && temp->data != val)
    {
        prev = temp;
        temp = temp->next;
    }

    if(temp == NULL)
    {
        cout << "Value not found\n";
        return;
    }

    if(prev == NULL)
        head = temp->next;
    else
        prev->next = temp->next;

    if(temp == tail)
        tail = prev;

    delete temp;

    if(head == NULL)
        tail = NULL;
}

void display()
{
    node *temp = head;

    while(temp != NULL)
    {
        cout << temp->data << " ";
        temp = temp->next;
    }
    cout << endl;
}

void reverseDisplay(node *temp)
{
    if(temp == NULL)
        return;

    reverseDisplay(temp->next);
    cout << temp->data << " ";
}

int main()
{
    first(20);
    first(10);
    last(30);
    last(40);

    cout << "Display: ";
    display();

    update(20, 25);

    cout << "After Update: ";
    display();

    del(30);

    cout << "After Delete: ";
    display();

    cout << "Reverse Display: ";
    reverseDisplay(head);

    return 0;
}
