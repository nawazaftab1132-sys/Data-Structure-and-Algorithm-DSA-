#include <iostream>
using namespace std;
int main()
{
    int arr[100];
    int n;
    cout << "Enter number of elements"<<endl;
    cin >> n;
    cout << "Enter array elements"<<endl;
    for(int i = 0; i < n; i++)
    {
        cin >> arr[i];
    }
    int value, position;
    cout << "Enter value to add: ";
    cin >> value;
    cout << "Enter position (0 to " << n << "): ";
    cin >> position;
    for(int i = n; i > position; i--)
    {
        arr[i] = arr[i - 1];
    }
    arr[position] = value;
    n++;
    cout << "Array after adding:\n";
    for(int i = 0; i < n; i++)
    {
        cout << arr[i] << " ";
    }
}
