#include <iostream>
using namespace std;
int main()
{
    int arr[5];
    int temp;
    cout << "Enter array elements :" << endl;
    for(int i = 0; i < 5; i++)
    {
        cin >> arr[i];
    }
    cout << "Array elements are :" << endl;
    for(int i = 0; i < 5; i++)
    {
        cout << arr[i] << endl    ;
    }
    for(int i = 0; i < 5 - 1; i++)
    {
        for(int j = 0; j < 5 - 1 - i; j++)
        {
            if(arr[j] > arr[j + 1])
            {
                temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }
    cout << endl << "Sorted Array :" << endl;
    for(int i = 0; i < 5; i++)
    {
        cout << arr[i] << endl;
    }
}
