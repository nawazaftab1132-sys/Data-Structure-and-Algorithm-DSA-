#include<iostream>
using namespace std;
int main()
{
    int k;
    cout << "Enter size: ";
    cin >> k;
    int arr[k];
    cout << "Enter values: ";
    for(int i = 0; i < k; i++)
    {
        cin >> arr[i];
    }
    for(int i = 1; i < k; i++)
    {
        int key = arr[i];
        int j = i - 1;

        while(j >= 0 && arr[j] > key)
        {
            arr[j + 1] = arr[j];
            j--;
        }

        arr[j + 1] = key;
    }
    cout << "Sorted array: ";
    for(int i = 0; i < k; i++)
    {
        cout << arr[i] << " ";
    }
}
